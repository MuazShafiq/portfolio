---
import { getImage } from "astro:assets";
import "@fontsource-variable/manrope";
import "@fontsource/dm-mono/300.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import portraitSource from "../assets/muaz-portrait.jpeg";
import App from "../App";
import "../styles/base.css";
import "../styles/header.css";
import "../styles/hero.css";
import "../styles/marquee.css";
import "../styles/projects.css";
import "../styles/capabilities.css";
import "../styles/experience.css";
import "../styles/about.css";
import "../styles/contact.css";
import "../styles/footer.css";
import "../styles/terminal-modal.css";
import "../styles/responsive.css";

const siteUrl = "https://muaz-shafiq-portfolio.vercel.app";
const socialImageUrl = `${siteUrl}/muaz-portrait-original.jpeg`;

// The hero portrait renders at roughly 200-300px wide in the layout (object-fit: cover
// inside a fixed-size slot), so it's built here as a right-sized, re-encoded WebP rather
// than shipping the ~250KB source JPEG as-is — see CLAUDE.md for why this lives in
// index.astro (astro:assets only optimizes images at the Astro-file build layer) and gets
// passed into the App island as props instead of being imported directly inside App.tsx.
const portrait = await getImage({ src: portraitSource, format: "webp", quality: 82 });

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Muaz Shafiq",
  url: siteUrl,
  image: socialImageUrl,
  jobTitle: "Software Engineer",
  description:
    "Software engineer building thoughtful full-stack products, AI experiences, and reliable systems.",
  email: "mailto:muaz.shafiq18@gmail.com",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lahore",
    addressCountry: "PK",
  },
  alumniOf: {
    "@type": "CollegeOrUniversity",
    name: "Ghulam Ishaq Khan Institute of Engineering Sciences and Technology",
  },
  sameAs: [
    "https://github.com/MuazShafiq",
    "https://www.linkedin.com/in/muaz-shafiq/",
  ],
  knowsAbout: [
    "Software Engineering",
    "Full-stack Development",
    "Artificial Intelligence",
    "React",
    "Next.js",
    "Node.js",
    "Laravel",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b0b0d" />
    <meta
      name="description"
      content="Muaz Shafiq is a Lahore-based software engineer building thoughtful full-stack products, AI experiences, and reliable systems."
    />
    <meta
      name="keywords"
      content="Muaz Shafiq, software engineer, full-stack developer, AI engineer, React developer, Next.js developer, Lahore"
    />
    <meta name="author" content="Muaz Shafiq" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Muaz Shafiq — Software Engineer" />
    <meta
      property="og:description"
      content="Full-stack products, AI experiences, and reliable systems—built with care."
    />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Muaz Shafiq, software engineer" />
    <meta property="profile:first_name" content="Muaz" />
    <meta property="profile:last_name" content="Shafiq" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Muaz Shafiq — Software Engineer" />
    <meta
      name="twitter:description"
      content="Full-stack products, AI experiences, and reliable systems—built with care."
    />
    <meta name="twitter:image" content={socialImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>Muaz Shafiq — Software Engineer · Full-stack & AI</title>
  </head>
  <body>
    <App client:load portraitSrc={portrait.src} portraitWidth={portrait.attributes.width} portraitHeight={portrait.attributes.height} />
  </body>
</html>
